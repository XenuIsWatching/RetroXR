# type: ignore
#
# Standalone GDExtension: vlc_godot (libVLC-backed DVD/video player for RetroXR).
# Builds separately from libretro-godot (two extensions can't share one SCons
# invocation), but reuses the same godot-cpp submodule checked out under
# libretro-godot/godot-cpp.
#
#   scons platform=windows arch=x86_64 target=template_debug
#   scons platform=linux   arch=x86_64 target=template_release
#   scons platform=android arch=arm64  target=template_debug ANDROID_HOME=
#
# Output goes to RetroXR/vlc-godot/ alongside the vendored libvlc runtime.

VariantDir('Temp', '.', duplicate=0)
env = Environment()

import os
output_dir = os.environ.get('VLC_GODOT_OUTPUT_DIR', '#../RetroXR/vlc-godot')

SConscript('Temp/SConscript', exports=['env', 'output_dir'])
