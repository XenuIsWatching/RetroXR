# Nintendo - GameCube / Wii (Dolphin), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. It lives in
# its own directory because res://libretro-core-info is vendored wholesale from
# libretro's repository and is refreshed wholesale too — an edit there would be
# lost the next time, silently.
#
# The binary this describes is built from XenuIsWatching/dolphin at the tag
# retroxr-dolphin-libretro-v6 and published on that repository's releases page,
# which is also where its source is: Dolphin is GPLv2+, so the two travel
# together.

# Software Information
display_name = "Nintendo - GameCube / Wii (Dolphin, retroXR)"
authors = "Team Dolphin"
supported_extensions = "gcm|iso|wbfs|ciso|gcz|elf|dol|dff|tgc|wad|rvz|m3u|wia"
corename = "Dolphin (retroXR)"
categories = "Emulator"
license = "GPLv2+"
permissions = ""
display_version = "retroXR build"

# Hardware Information
manufacturer = "Nintendo"
systemname = "GameCube"
systemid = "gamecube"
secondary_systemids = "wii:wbfs,rvz,wia,wad"

# Libretro Features
database = "Nintendo - GameCube|Nintendo - Wii|Nintendo - Wii (Digital)"
supports_no_game = "false"
savestate = "true"
savestate_features = "basic"
libretro_saves = "true"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
core_options = "true"
core_options_version = "1.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.0 | Direct3D >= 10.0 | OpenGL Core >= 3.3 | OpenGL ES >= 3.0"
needs_fullpath = "true"
disk_control = "false"
is_experimental = "false"

# BIOS/Firmware
firmware_count = 4
firmware0_desc = "Dolphin 'Sys' folder"
firmware0_path = "dolphin-emu/Sys/codehandler.bin"
firmware0_opt = "false"
firmware1_desc = "dolphin-emu/Sys/GC/JAP/IPL.bin (GameCube JP BIOS)"
firmware1_path = "dolphin-emu/Sys/GC/JAP/IPL.bin"
firmware1_opt = "true"
firmware2_desc = "dolphin-emu/Sys/GC/USA/IPL.bin (GameCube US BIOS)"
firmware2_path = "dolphin-emu/Sys/GC/USA/IPL.bin"
firmware2_opt = "true"
firmware3_desc = "dolphin-emu/Sys/GC/EUR/IPL.bin (GameCube EU BIOS)"
firmware3_path = "dolphin-emu/Sys/GC/EUR/IPL.bin"
firmware3_opt = "true"
notes = "(!) You need the Dolphin 'Sys' folder in 'system/dolphin/dolphin-emu' — the BIOS/Extras tab fetches it.|(!) Installs over the buildbot's Dolphin under the same name, so the Sys folder, GameCube memory cards and Wii NAND all carry across.|(!) Set Sensor Bar Position (Top/Bottom) to match where you actually stood the bar — the Wii only sees two dots, so that setting is what tells it which way to shift the pointer.|(!) The GameCube BIOS files can be stored in '<save_dir>/User/GC/<region>/' as an alternative to '<system_dir>/dolphin-emu/Sys/GC/<region>/'."

description = "Dolphin for GameCube and Wii, built from retroXR's fork. It is the stock libretro Dolphin plus three things a VR room needs. Wiimote IR passthrough: with it enabled the frontend projects the sensor bar's two LEDs into the camera in the nose of the emulated remote and hands the core the pixel coordinates, so the aim is geometry rather than a cursor position — it carries roll and distance, moving the bar moves the pointer, and pointing away hides the cursor instead of pinning it to the edge. The stock build can only be told where a cursor is, and turns that back into a camera view by rotating a notional remote parked two metres from the bar, by a scale no geometry produces. A gyroscope fix: MotionPlus is a device type of its own and its rotation rates reach the core intact, so a game steered by turning the remote actually steers. And a deadlock fix: in dual-core mode retro_run drives the GPU loop on the frontend's own thread, and that loop only ended when the CPU thread reached an emulated field boundary — which can never arrive while the core is paused. Landing there left the core running with no picture, deaf to a reset and impossible to shut down; on a Quest it caught roughly one boot in three. It now leaves the loop when the emulation is paused, and the next frame resumes it. Everything else is upstream Dolphin: the same Sys folder, the same saves, the same options. Source and binaries: github.com/XenuIsWatching/dolphin/releases/latest & the tag it points at."
