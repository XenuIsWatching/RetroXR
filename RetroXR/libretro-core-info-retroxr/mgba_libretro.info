# Nintendo - Game Boy Advance (mGBA), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. It lives in
# its own directory because res://libretro-core-info is vendored wholesale from
# libretro's repository and is refreshed wholesale too — an edit there would be
# lost the next time, silently.
#
# The binary this describes is built from XenuIsWatching/mgba at the tag
# retroxr-mgba-libretro-v4 and published on that repository's releases page,
# which is also where its source is. mGBA is MPL-2.0, so no source obligation
# rides with the binary; the tag is beside it so anyone can tell what they are
# running.

# Software Information
display_name = "Nintendo - Game Boy Advance (mGBA, retroXR)"
authors = "endrift"
supported_extensions = "gb|gbc|gba"
corename = "mGBA (retroXR)"
license = "MPLv2.0"
permissions = ""
categories = "Emulator"
display_version = "retroXR build"

# Hardware Information
manufacturer = "Nintendo"
systemname = "Game Boy Advance"
systemid = "game_boy_advance"
secondary_systemids = "game_boy:gb,gbc|ereader:raw"

# Libretro Features
supports_no_game = "false"
database = "Nintendo - Game Boy|Nintendo - Game Boy Color|Nintendo - Game Boy Advance"
savestate = "true"
savestate_features = "deterministic"
cheats = "true"
input_descriptors = "true"
memory_descriptors = "true"
libretro_saves = "true"
core_options = "true"
load_subsystem = "false"
hw_render = "false"
needs_fullpath = "false"
disk_control = "false"
is_experimental = "false"

# Firmware / BIOS
firmware_count = 7
