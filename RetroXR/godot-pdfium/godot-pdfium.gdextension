[configuration]

entry_symbol = "godot_pdfium_library_init"
compatibility_minimum = "4.4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "godot-pdfium.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "godot-pdfium.windows.template_release.x86_64.dll"
android.debug.arm64 = "libgodot-pdfium.android.template_debug.arm64.so"
android.release.arm64 = "libgodot-pdfium.android.template_release.arm64.so"
linux.debug.x86_64 = "libgodot-pdfium.linux.template_debug.x86_64.so"
linux.release.x86_64 = "libgodot-pdfium.linux.template_release.x86_64.so"
linux.debug.arm64 = "libgodot-pdfium.linux.template_debug.arm64.so"
linux.release.arm64 = "libgodot-pdfium.linux.template_release.arm64.so"
macos.debug.universal = "libgodot-pdfium.macos.template_debug.universal.dylib"
macos.release.universal = "libgodot-pdfium.macos.template_release.universal.dylib"
macos.debug.arm64 = "libgodot-pdfium.macos.template_debug.arm64.dylib"
macos.release.arm64 = "libgodot-pdfium.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "libgodot-pdfium.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "libgodot-pdfium.macos.template_release.x86_64.dylib"

[dependencies]

windows.debug.x86_64 = {"pdfium.dll": ""}
windows.release.x86_64 = {"pdfium.dll": ""}
android.debug.arm64 = {"libpdfium.so": ""}
android.release.arm64 = {"libpdfium.so": ""}
linux.debug.x86_64 = {"linux-x64/libpdfium.so": ""}
linux.release.x86_64 = {"linux-x64/libpdfium.so": ""}
linux.debug.arm64 = {"linux-arm64/libpdfium.so": ""}
linux.release.arm64 = {"linux-arm64/libpdfium.so": ""}
macos.debug.universal = {"mac-arm64/libpdfium.dylib": "", "mac-x64/libpdfium.dylib": ""}
macos.release.universal = {"mac-arm64/libpdfium.dylib": "", "mac-x64/libpdfium.dylib": ""}
macos.debug.arm64 = {"mac-arm64/libpdfium.dylib": ""}
macos.release.arm64 = {"mac-arm64/libpdfium.dylib": ""}
macos.debug.x86_64 = {"mac-x64/libpdfium.dylib": ""}
macos.release.x86_64 = {"mac-x64/libpdfium.dylib": ""}
