[configuration]

entry_symbol = "verlet_rope_library_init"
compatibility_minimum = "4.4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "verlet_rope.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "verlet_rope.windows.template_release.x86_64.dll"
android.debug.arm64 = "libverlet_rope.android.template_debug.arm64.so"
android.release.arm64 = "libverlet_rope.android.template_release.arm64.so"
linux.debug.x86_64 = "libverlet_rope.linux.template_debug.x86_64.so"
linux.release.x86_64 = "libverlet_rope.linux.template_release.x86_64.so"
linux.debug.arm64 = "libverlet_rope.linux.template_debug.arm64.so"
linux.release.arm64 = "libverlet_rope.linux.template_release.arm64.so"
macos.debug.universal = "libverlet_rope.macos.template_debug.universal.dylib"
macos.release.universal = "libverlet_rope.macos.template_release.universal.dylib"
macos.debug.arm64 = "libverlet_rope.macos.template_debug.arm64.dylib"
macos.release.arm64 = "libverlet_rope.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "libverlet_rope.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "libverlet_rope.macos.template_release.x86_64.dylib"
