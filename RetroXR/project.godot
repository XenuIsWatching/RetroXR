; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RetroXR"
config/version="0.4.0"
run/main_scene="uid://bh8x3sbal8nds"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Textures/app_icon.png"
run/main_scene.rendermodelprobe="res://Tools/quest_render_model_probe.tscn"

[audio]

driver/mix_rate=48000

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
AppPrefs="*res://Scripts/Data/app_prefs.gd"
QualityManager="*res://Scripts/quality_manager.gd"
SceneManager="*res://Scripts/Data/scene_manager.gd"
NetworkManager="*res://Scripts/Net/network_manager.gd"
SpatialAudioListener="*res://Scripts/Audio/spatial_audio_listener.gd"
VRKeyboard="*res://Scripts/UI/widgets/vr_keyboard_fix.gd"
Typing="*res://Scripts/UI/widgets/typing_guard.gd"
SaveSync="*res://Scripts/Data/romm/romm_save_sync.gd"
StateSync="*res://Scripts/Data/romm/romm_state_sync.gd"
RA="*res://Scripts/Data/ra/ra_session.gd"
HeldPhysics="*res://Scripts/Interaction/held_object_physics.gd"

[debug]

gdscript/warnings/missing_tool=0

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440

[dotnet]

project/assembly_name="retroxr"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/retroxr_qr/plugin.cfg", "res://addons/retroxr_build_stamp/plugin.cfg")

[importer_defaults]

texture={
"compress/size_limit": 2048
}

