[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_3="Pickable"
3d_physics/layer_17="XRHand_SnapZone"
3d_physics/layer_18="XRHand_Physics"
3d_physics/layer_19="XRPickable"
3d_physics/layer_20="XRButton"
3d_physics/layer_21="XRPointer"
3d_physics/layer_22="XRPoseDetector"
3d_physics/layer_23="XRPointerSuppress"

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="Jolt Physics"
3d/sleep_threshold_linear=0.15
3d/sleep_threshold_angular=0.1
3d/solver/contact_recycle_radius=0.005
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
reflections/reflection_atlas/reflection_count=4
anti_aliasing/quality/msaa_3d=1
openxr/multiview=true
renderer/rendering_method.android="mobile"
limits/spatial_indexer/threaded_cull_minimum_instances.android=65536

[threading]

worker_pool/max_threads.android=2

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/render_model=true
shaders/enabled=true
openxr/extensions/meta/passthrough=true
openxr/extensions/meta/hand_tracking_mesh=true
openxr/extensions/meta/render_model=true
openxr/extensions/meta/composition_layer_settings/main_projection_layer/filtering/sharpening_mode=1
