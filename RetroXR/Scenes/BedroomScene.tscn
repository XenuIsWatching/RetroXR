surface_material_override/0 = SubResource("Mat_tod_ball")

; The Area3D sits ON the ball, not on the pivot: VRHinge measures tip proximity from
; this node's own origin, so a hinge parked at the pivot would arm when a hand came
; near the hub instead of near the handle. Child of the pivot, so it rides the arm.
;
; value_at_max = 0 puts MORNING at +65 deg, the door side, which is the player's left
; when facing this wall; night is the far end. Left to right, as it reads.
[node name="Lever" type="Area3D" parent="Furniture/TimeLever/LeverPivot" node_paths=PackedStringArray("target")]
