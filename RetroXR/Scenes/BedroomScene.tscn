; Wall-to-wall carpet. tiles_per_metre is a real metric density now, so the pile
; matches the plaster's scale where the two meet at the baseboard instead of
; being a third, unrelated tiling the way uv1_scale 4 on a PlaneMesh was.
; Carpet016 is the one set in this room that ships an AmbientOcclusion map, and
; it earns it: pile is exactly the kind of deep micro-relief a tiling AO does
; describe. The plaster has no AO map, and would not want one — see the shader.
[sub_resource type="ShaderMaterial" id="Mat_carpet"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("23_rug_col")
shader_parameter/roughness_tex = ExtResource("25_rug_rgh")
shader_parameter/normal_tex = ExtResource("24_rug_nrm")
shader_parameter/ao_tex = ExtResource("26_rug_ao")
shader_parameter/tint = Color(1, 0.97, 0.9, 1)
shader_parameter/tiles_per_metre = 0.8
shader_parameter/normal_strength = 1.0
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = false
shader_parameter/swap_uv = false
shader_parameter/ao_enabled = true
shader_parameter/ao_strength = 0.45
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.45
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.5

; Painted drywall (ambientCG Plaster001, surface photogrammetry).
;
; Replaced PaintedPlaster017, which was tagged only "painted/plaster/white" but
; has a branching crack running through it — and the crack is carved into its
; NORMAL map as well as its albedo, so raking lamplight picked it out and the
; wall read as damaged rather than painted. Nearly the whole PaintedPlaster
; series is tagged "broken", "old" or "cracks"; the Plaster series is where the
; clean ones are. Plaster001 is tagged "clean", has fine even relief with no
; cracks anywhere, and is the most-downloaded plaster on the site.
; The source is white, so albedo_color tints it cream — one texture set can
; re-skin every wall in the project at any colour.
;
; The normal map is the reason this beats a flat colour: shadows are OFF on Quest,
; so per-pixel normals are the only thing giving the walls form. It only shows
; under directional light — the window sun, and the ceiling globe after dark.
; The tint is near-NEUTRAL on purpose. It used to be Color(0.78, 0.71, 0.58) —
; strongly warm — against a texture whose base is 0.745/0.747/0.734, i.e. grey.
; Plaster001's base is 0.843/0.828/0.815: brighter and slightly warm already, so
; the same tint compounded into orange and the walls read as adobe. The room's
; ambient is Color(1, 0.84, 0.70) and the ceiling globe is warm, so the warmth
; wants to come from the light, not from the paint as well.
;
; It is on room_surface.gdshader rather than a StandardMaterial3D for two
; reasons the shader's own header sets out at length. Short version: a BoxMesh
; normalises its UVs per face, so ONE uv1_scale gave the 5.2 m south wall 0.48
; tiles/m and the 0.5 m strip beside the door 5.0 — a 10x step at the corner
; where they meet — and nothing darkens a corner on Quest, where shadows are off
; and SSAO is a no-op on the mobile backend.
[sub_resource type="ShaderMaterial" id="Mat_wall"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("20_wall_col")
shader_parameter/roughness_tex = ExtResource("22_wall_rgh")
shader_parameter/normal_tex = ExtResource("21_wall_nrm")
shader_parameter/tint = Color(0.72, 0.7, 0.67, 1)
shader_parameter/tiles_per_metre = 0.75
shader_parameter/normal_strength = 1.15
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = false
shader_parameter/swap_uv = false
shader_parameter/ao_enabled = false
shader_parameter/ao_strength = 1.0
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.45
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.5

; The ceiling was a flat untextured colour, which in VR is a large surface
; directly overhead. Same plaster as the walls at the same metric density, so the
; two agree where they meet, tinted lighter the way a ceiling is painted.
[sub_resource type="ShaderMaterial" id="Mat_ceiling"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("20_wall_col")
shader_parameter/roughness_tex = ExtResource("22_wall_rgh")
shader_parameter/normal_tex = ExtResource("21_wall_nrm")
shader_parameter/tint = Color(0.8, 0.78, 0.75, 1)
shader_parameter/tiles_per_metre = 0.75
shader_parameter/normal_strength = 0.7
shader_parameter/roughness_scale = 1.1
shader_parameter/object_space = false
shader_parameter/swap_uv = false
shader_parameter/ao_enabled = false
shader_parameter/ao_strength = 1.0
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.45
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.5

; White painted door leaf. The kit's leaf and its jamb are two surfaces of ONE
; mesh, so the leaf is re-skinned through surface_material_override/4 and the
; jamb keeps its painted trim.
;
; It is still a WOOD set (ambientCG Wood049, oak) even though the door is white:
; paint_over 0.9 covers the oak's colour while its grain, mill marks and
; roughness variation keep coming through the normal and roughness maps. That is
; what separates a painted door from the flat white one the kit shipped — a
; painted panel door is not a uniform surface, it just is not brown.
;
; object_space, unlike every other user of this shader: the door is a yawed prop,
; and sampling it in the room's frame would run the grain through the leaf at 90
; deg to its own stiles. Its model frame is also why the shell must NOT use this
; flag — each wall piece would restart its tiling at its own centre and the
; corner step would come straight back.
[sub_resource type="ShaderMaterial" id="Mat_door_wood"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("53_wood_col")
shader_parameter/roughness_tex = ExtResource("55_wood_rgh")
shader_parameter/normal_tex = ExtResource("54_wood_nrm")
shader_parameter/tint = Color(0.9, 0.89, 0.86, 1)
shader_parameter/paint_over = 0.9
shader_parameter/tiles_per_metre = 0.55
shader_parameter/normal_strength = 0.55
shader_parameter/roughness_scale = 0.75
shader_parameter/object_space = true
shader_parameter/swap_uv = true
shader_parameter/ao_enabled = false
shader_parameter/ao_strength = 1.0
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
