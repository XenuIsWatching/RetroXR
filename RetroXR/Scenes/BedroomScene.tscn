outline_modulate = Color(0.12, 0.11, 0.1, 0.85)
text = ""
font = ExtResource("52_nerdfont")
font_size = 72
outline_size = 5

[node name="TickNight" type="Label3D" parent="Furniture/TimeLever/Plate"]
