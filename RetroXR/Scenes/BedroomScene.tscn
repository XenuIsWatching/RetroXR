; Ceiling fan globe. Grouped "ceiling_light", so QualityManager overwrites the
; energy to 0.8 desktop / 0.6 Quest — the authored value here is only what shows
; before it runs.
;
; It sits at y 2.29, the centre of the glass globe (which spans 2.227..2.357),
; and casts NO shadow. At 2.35 it was up against the motor housing and, with
; shadows on, the shade boxed it in completely: the fan lit nothing at all.
; Frosted glass is translucent and Godot's shadow map is not, so the shade has to
; be taken out of the equation rather than worked around. It opts out via the
; "no_shadow" group, not a shadow_enabled property: QualityManager.configure_light
; writes shadow_enabled on every Light3D in the tree, so an authored false here
; was silently overwritten every run. Shadows are off on
; Quest anyway, so this also makes the desktop view match the headset.
;
; The cull mask is the price of that: with no shadow to stop it, a 7 m light
; would reach straight through the walls and into the suburb outside, so it is
; masked to layer 1 the way Dusk already is.
[node name="FanGlobeLight" type="OmniLight3D" parent="." groups=["ceiling_light", "no_shadow"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.29, 0)
light_color = Color(1, 0.85, 0.62, 1)
light_energy = 1.2
light_cull_mask = 1
omni_range = 7.0

; Golden-hour sun through the window. See the note in this file's history: this is
; a SpotLight3D rather than a DirectionalLight because shadows are OFF on Quest,
; so a directional sun lights the room through its walls. The cone does the
; occluding a shadow map would normally do — at the window plane it is 1.27 m
; across against a 1.5 x 1.2 m opening, so nothing spills onto the wall around it.
;
; Energy is owned by the blinds, which scale it by how far they are open. The
; authored 3.0 is what shows with them fully raised.
[node name="WindowSun" type="SpotLight3D" parent="." groups=["no_shadow"]]
transform = Transform3D(-0.991, -0.057, 0.116, 0, 0.895, 0.444, -0.129, 0.44, -0.888, -0.6, 2.6, -4.5)
light_color = Color(1, 0.83, 0.62, 1)
light_energy = 3.6
light_cull_mask = 1
spot_range = 12.0
spot_angle = 11.0
spot_angle_attenuation = 0.55
[node name="TimeOfDay" type="Node3D" parent="."]
script = ExtResource("50_timeofday")
world_env_path = NodePath("../WorldEnvironment")
blinds_path = NodePath("../Furniture/Blinds")
room_daylight_path = NodePath("../Dusk")
window_sun_path = NodePath("../WindowSun")
exterior_sun_path = NodePath("../ExteriorSun")
exterior_fill_path = NodePath("../ExteriorFill")
street_lamp_path = NodePath("../Exterior/StreetLamp/Light")
street_lamp_head_path = NodePath("../Exterior/StreetLamp/Head")
lever_path = NodePath("../Furniture/TimeLever/LeverPivot/Lever")

