outline_modulate = Color(0.12, 0.11, 0.1, 0.85)
text = ""
font = ExtResource("52_nerdfont")
font_size = 72
outline_size = 5

; IDENTITY, and VRLever's target. The hinge writes target.rotation.x and measures
; the hand in the parent frame, so the basis has to live on the mount above and this
; node has to stay clean.
[node name="LeverPivot" type="Node3D" parent="Furniture/TimeLever"]

[node name="Arm" type="MeshInstance3D" parent="Furniture/TimeLever/LeverPivot"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, 0.018, 0, -0.055)
mesh = SubResource("Mesh_tod_arm")
surface_material_override/0 = SubResource("Mat_tod_arm")

[node name="Ball" type="MeshInstance3D" parent="Furniture/TimeLever/LeverPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.018, 0, -0.11)
mesh = SubResource("Mesh_tod_ball")
surface_material_override/0 = SubResource("Mat_tod_ball")

; The Area3D sits ON the ball, not on the pivot: VRHinge measures tip proximity from
; this node's own origin, so a hinge parked at the pivot would arm when a hand came
; near the hub instead of near the handle. Child of the pivot, so it rides the arm.
;
; value_at_max = 0 puts MORNING at +65 deg, the door side, which is the player's left
; when facing this wall; night is the far end. Left to right, as it reads.
[node name="Lever" type="Area3D" parent="Furniture/TimeLever/LeverPivot" node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.018, 0, -0.11)
collision_layer = 0
collision_mask = 0
script = ExtResource("51_vrlever")
target = NodePath("..")
min_deg = -65.0
max_deg = 65.0
engage_radius = 0.05
value_at_min = 1.0
value_at_max = 0.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Furniture/TimeLever/LeverPivot/Lever"]
shape = SubResource("Shape_tod_ball")

[node name="HingeHint" type="Label3D" parent="Furniture/TimeLever/LeverPivot/Lever"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.055, 0, -0.03)
[node name="Blinds" type="Node3D" parent="Furniture"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 2.05, -2.06)
script = ExtResource("49_blinds")
width = 1.44
height = 1.18
sun_path = NodePath("../../WindowSun")
sun_energy = 3.6
daylight_path = NodePath("../../Dusk")
env_path = NodePath("../../WorldEnvironment")
drop = 0.25

; The blind cord. Same BeadPullCord as the lamps, but beads off — a blind cord is
; a flat string, not a ball chain — and no light_path, so it drives only the
; blinds. Longer than the lamp cords because a blind cord hangs to reach.
[node name="BlindCord" type="Node3D" parent="Furniture"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.235, 2.02, -2.055)
script = ExtResource("48_pullcord")
beads = false
cord_radius = 0.0026
cord_length = 0.46
segments = 12
yank = 0.22
bead_color = Color(0.9, 0.88, 0.82, 1)

[node name="FanPivot" type="Node3D" parent="Furniture"]
script = ExtResource("35_glow")
; defaultMaterial5 is the spiral CFL pigtail modelled inside the shade;
; defaultMaterial4 is the glass globe around it. The globe used to be the emissive
; one, which lit the GLASS and left the bulb dark — the fixture read as a glowing
; ball. Now the bulb glows and the globe is translucent so you see it through the
; frosting.
;
; 4.5 rather than the globe's old 2.2: the bulb is a fraction of the globe's
; surface area, so the same energy over less area reads far dimmer.
glow_meshes = PackedStringArray("defaultMaterial5")
glass_meshes = PackedStringArray("defaultMaterial4")
glow_color = Color(1, 0.82, 0.55, 1)
glow_energy = 4.5

[node name="Fan" parent="Furniture/FanPivot" instance=ExtResource("14_fan")]
transform = Transform3D(0.00283, 0, 0, 0, 0.00283, 0, 0, 0, 0.00283, 0.2181, 0.4982, -0.5128)

; 2 s per revolution, half the den's 4 s. Four seconds is 15 rpm, slower than any
; real fan and it reads as coasting to a stop rather than running. At 30 rpm a
; four-blade fan passes a blade every 0.5 s, nowhere near the 72 Hz refresh, so
; there is no strobing.
;
; The pivot is at the world origin and the hub sits at (0, 2.39, 0), so rotating
; about Y already turns the blades about their own axis — no offset to correct,
; unlike the den's 3-blade fan whose asymmetric AABB put the pivot 0.111 m off
; centre. FanGlobeLight is parented to the scene root, not to the pivot, so the
; light does not swing round the room with the blades.
[node name="FanSpin" type="AnimationPlayer" parent="Furniture"]
libraries = {
&"": SubResource("AnimLib_fan")
}
autoplay = "spin"

; --- Furniture colliders ------------------------------------------------------
; One box per piece of room-owned furniture, hand-fitted, collision_mask = 0 so
; they collide with nothing themselves. Only the door is left: the bed, desk,
; bookcases, TV stand, nightstand, chair and wardrobe this body used to mirror
; were removed when the room was emptied, and a collider outliving its mesh is an
; invisible wall. Anything the player puts here now brings its own collision.
[node name="FurnitureCollision" type="StaticBody3D" parent="."]
collision_mask = 0
[node name="DoorCol" type="CollisionShape3D" parent="FurnitureCollision"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.6, 1.035, 1.2)
shape = SubResource("Shape_door")

; Six-panel door with its jambs, knob and hinges, from the Interior Trim Assets
; kit. Yawed 90 deg so its width runs along the west wall's opening. Closed and
; collidered — the opening was a hole straight through to the sky before this.
; Surface 4 is the leaf, surface 0 the jamb and casing; 1-3 are the hinges and
; the two knob halves. Only the leaf takes the oak.
[node name="Door" parent="Furniture" instance=ExtResource("19_door")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -2.6, -2.018, 0.89)

[node name="Door Jamb_001_Trim_0" parent="Furniture/Door" index="0"]
surface_material_override/4 = SubResource("Mat_door_wood")
; Closet door. The same kit as the room door, so the opening could be authored at
; the size that door is known to seat in rather than a new one guessed at.
;
; R_y(180) from the west-wall instance, because "into the room" is -Z here and +X
; there. Its origin is x -1.805 rather than the opening centre -1.5: the assembly
; is not centred on its own node, and rotating it moves that offset from +Z to
; +X. -1.805 was DERIVED — the west door's node origin and the measured world
; centre give a local offset of (-0.305, 3.081, 0), which under this basis lands
; at (0.305, 3.081, 0). Do not eyeball this number; a probe printed the AABB.
