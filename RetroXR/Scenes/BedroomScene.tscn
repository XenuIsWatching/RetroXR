[node name="HouseD" parent="Exterior" instance=ExtResource("5_house_b")]
transform = Transform3D(7, 0, 0, 0, 7, 0, 0, 0, 7, 18, -0.05, -33)

; A second row further back, smaller in frame, so the street has depth instead of
; ending in a flat wall of facades.
[node name="HouseFarA" parent="Exterior" instance=ExtResource("8_house2e")]
transform = Transform3D(7, 0, 0, 0, 7, 0, 0, 0, 7, -14, -0.05, -52)

; house_two_b, not house_two_a. This was the SAME model as HouseA — the only
; repeat in the street, and both are in the window at once. house_two_b was
; already on disk and in LFS and had never been instanced.
;
; Nothing else needs a new model: the near row already runs x -25.55..22.58 with
; 3.9 m between houses, and the window only sees about +/-21 m at that depth, so
; there is neither room to add one nor view to put it in.
[node name="HouseFarB" parent="Exterior" instance=ExtResource("64_house2b")]
transform = Transform3D(7, 0, 0, 0, 7, 0, 0, 0, 7, 12, -0.05, -53)

; The tree row is one instance of a 5-tree mesh that lives at x 198..223 in its
; own space, so the origin below carries a -253 offset to bring it back. Scale
; 1.2 makes them ~8 m tall and ~6 m apart, which is about right for street trees.
[node name="TreeRow" parent="Exterior" instance=ExtResource("9_trees")]
transform = Transform3D(1.2, 0, 0, 0, 1.2, 0, 0, 0, 1.2, -256.9, -0.04, -26)

; NormalTree_2 stood directly behind the street lamp from the window: the lamp
; head sits at y 2.85 and this row's canopies run up to 4.99, so the glowing head
; was buried in foliage and the two read as one object in the same spot.
;
; Moved along the verge to the far end rather than nudged. The canopies here are
; 3.7-6.8 m wide with only ~0.75 m between them, so the row is very nearly a
; continuous hedge — sliding it sideways just puts a different tree behind the
; lamp, and a 0.75 m gap at 26 m only lines up from one exact eye position. Taking
; this one out of the middle leaves a 6.97 m hole between NormalTree_1 and _3,
; centred on x -10.5, which is where the sightline from the window crosses this
; row (-9.6 to -10.4 across the positions a player stands in). It clears from
; every one of them.
;
; Local x, so it is scaled by the row's 1.2: 205.3896 + 20.8708 puts the canopy at
; 11.77..17.24, which leaves the same ~0.74 m to NormalTree_5 that the row uses
; between every other pair. Nothing overlaps.
; position, NOT transform. Every tree in this kit carries scale 100 and an
; R_x(-90) basis, so writing a whole Transform3D here means restating those by
; hand — and getting it wrong collapsed this canopy from 5.47 m wide to 0.06 m,
; which still passed a sightline check because a 60 mm tree blocks nothing.
; Overriding the position alone leaves the basis exactly as the kit authored it.
[node name="NormalTree_2" parent="Exterior/TreeRow/RootNode" index="1"]
position = Vector3(226.2604, 0, 0)

[node name="TreeRowFar" parent="Exterior" instance=ExtResource("9_trees")]
transform = Transform3D(-1.4, 0, 0, 0, 1.4, 0, 0, 0, -1.4, 289, -0.04, -45)

; --- Front yard --------------------------------------------------------------
; The 14 m of lawn between this wall and the kerb was the emptiest part of the
; view: at eye level it is a plain green band with nothing in it to say how far
; away the road is. These are what break it up. All Kenney City Kit (Suburban),
; CC0, the same author as the houses, so there is no style to reconcile.
;
; Everything here sits inside the window's view wedge. From a metre back the
; opening only shows about x -11.7..9.9 at the kerb and x -3.6..1.8 five metres
; out, so props outside that cost draw calls nobody ever sees.

; --- Front yard --------------------------------------------------------------
; What the window can SEE is the constraint. Through a 1.5 m opening from a metre
; back the cone is narrow: about x -3.6..1.8 five metres out, widening to
; -11.7..9.9 by the kerb. Props off at the sides are simply not in the picture.
;
; No fence across the front. One at the property line reads correctly and wrecks
; the view: to keep the middle of the road visible past it from a standing eye it
; would have to be under 0.36 m tall, which is edging rather than a fence. An
; open lawn running to the sidewalk is what a US suburb looks like anyway.
;
; So the mid-ground is flat surfaces straight ahead, which fill the empty green
; band without occluding anything, and they are the same photographic PBR the
; lawn and road use rather than a second art style parked in the near field.
; Two draw calls.

; A walkway from the house out to the sidewalk, straight up the middle of the
; window. A receding line up the centre does more for depth than anything
; standing in the yard, and costs no occlusion at all.
[node name="FrontPath" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 0.012, -9.4)
mesh = SubResource("Mesh_path")
surface_material_override/0 = SubResource("Mat_aggregate")

[node name="Driveway" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.4, 0.012, -9.05)
mesh = SubResource("Mesh_driveway")
surface_material_override/0 = SubResource("Mat_aggregate")

