[node name="HouseB" parent="Exterior" instance=ExtResource("4_house_a")]
transform = Transform3D(7, 0, 0, 0, 7, 0, 0, 0, 7, -8, -0.05, -33)

[node name="HouseC" parent="Exterior" instance=ExtResource("7_house2d")]
