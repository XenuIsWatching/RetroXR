; --- Furniture ----------------------------------------------------------------
; Transforms below were solved once by a throwaway fit probe (target size +
; target world position + yaw) and baked here, per the project's "author in the
; .tscn" convention. The downloads arrive at wildly different scales — the fan
; and trash can are ~450 units across and offset hundreds of units from their
; own origin — so none of these numbers are guessable by hand.
[node name="Furniture" type="Node3D" parent="."]

; Two-gang toggle plate, west wall, 1.2 m up. The plate and the bats are baked by
; Tools/gen/gen_light_switch.gd; nothing here is downloaded.
;
; The node's basis puts local +Z out of the wall and local +Y up, which is the frame
; both meshes are authored in — so the plate mounts with its back face ON the wall at
; x = -2.525 and needs no fitted offset, and each Button is an identity basis with a
; position. (Basis rows here are the .tscn's row-major listing: columns are
; x = (0,0,-1), y = (0,1,0), z = (1,0,0).)
;
; Gangs sit on the real 47.6 mm pitch, +/- 23.85 mm along local X. The plate is 116 mm
; wide, so its edges reach z = 0.492 .. 0.608 in the room: clear of the TimeLever
; (0.30 m north, z 0.25) and of the door opening (z 0.70 .. 1.70).
[node name="SwitchPlate" type="Node3D" parent="Furniture"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -2.525, 1.2, 0.55)

[node name="Plate" type="MeshInstance3D" parent="Furniture/SwitchPlate"]
mesh = ExtResource("28_plate")

; Grounded US duplex receptacle on the open north-wall run at customary low-wall
; height. It uses the same ivory molded finish as the switch plate;
; Tools/gen/gen_wall_outlet.gd bakes both receptacles into one light mesh. Quad-style
; local +Z already points into the room here, so no fitted rotation is required.
[node name="WallOutlet" type="MeshInstance3D" parent="Furniture"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.65, 0.30, -2.125)
mesh = ExtResource("28_outlet")

; Both halves are usable snap targets. Their origins are the plug mating planes,
; 8.6 mm in front of the wall where the generated receptacle faces end.
[node name="TopPort" parent="Furniture/WallOutlet" instance=ExtResource("85_powerport")]
transform = Transform3D(1,0,0,0,1,0,0,0,1,0,0.022,0.0086)
[node name="BottomPort" parent="Furniture/WallOutlet" instance=ExtResource("85_powerport")]
transform = Transform3D(1,0,0,0,1,0,0,0,1,0,-0.022,0.0086)

; Left gang: the ceiling fan globe.
[node name="Ceiling" type="Node3D" parent="Furniture/SwitchPlate"]
script = ExtResource("29_switchscript")
target = 0

; The bat's pivot sits ON the aperture floor (z = THICK - WELL = 5.5 mm) and 4 mm of
