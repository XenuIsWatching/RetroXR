; --- Time-of-day lever -------------------------------------------------------
; West wall, same pier as the light switch, 0.30 m north of it so the two never
; share a grab volume, and 0.45 m clear of the door opening (z 0.70 .. 1.70).
;
; The basis IS the hinge axis, and it was derived by round-tripping a real node
; rather than written by hand: .tscn Transform3D lists the basis ROWS, the transpose
; of what the constructor takes, and guessing it wrong is silent.
;   local X = world +X  the axis, straight out of the wall
;   local Y = world +Z  toward the door, so a positive angle swings that way
;   local Z = world -Y  so local -Z is UP and the arm stands up at 0 deg
; Verified: the ball's world x holds at -2.525 across the whole sweep (a turn about
; the wall normal) while z sweeps 0.150 .. 0.350.
[node name="TimeLever" type="Node3D" parent="Furniture"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, -2.525, 1.15, 0.25)

[node name="Plate" type="MeshInstance3D" parent="Furniture/TimeLever"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.006, 0, -0.085)
mesh = SubResource("Mesh_tod_plate")
surface_material_override/0 = SubResource("Mat_tod_plate")

; Four glyphs from the Nerd Font's Weather Icons set, one per time the lever
; selects, each tinted in that time's own colour.
;
; They must carry the BUNDLED font. A bare Unicode sun or moon renders as tofu on
; Quest, where the theme font has no such glyph — these codepoints are in the
; Private Use Area and exist only in SymbolsNerdFont-Regular.ttf. Tests/
; time_of_day_tests.tscn --only=glyphs asserts the font is attached AND that it
; actually has each codepoint, because a tofu box is a silent failure.
;
; Tinted as well as drawn, because sunrise and sunset are the same sun over the
; same horizon and differ only in which way the chevron points — at 20 mm on a
; wall that is not a difference. Colour and arc position carry it; the glyph is the
; support cue. (menu_icons.gd records the same reasoning for its two bins.)
;
; Label3D, one draw call each. Unshaded so the tint IS the colour, and outlined so
; every one of them reads against the plate whatever the room's light is doing.
;
; They ring the ball's path at radius 0.160 — 28 mm beyond the 0.132 the ball's far
; edge reaches, which is what it takes for an END glyph to stay READABLE with the
; lever parked on it. At 0.132 the ball sat straight on top of the evening glyph;
; even at 0.150 it still covered most of the morning and night ones, hiding each
; label at exactly the position it names.
;
; The plate (0.37 x 0.20, centred at -0.085) is sized from the glyphs' measured
; AABBs, not from their origins. Drawn, these are 40-60 mm across — the sunrise one
; is the widest — so an origin comfortably inside the plate still hung its rays over
; the edge. Tests/time_of_day_tests.tscn --only=glyphs measures the real corners.
; The plate also has to reach down past the pivot the arm turns about, which is what
; puts its centre well below the arc.
[node name="TickMorning" type="Label3D" parent="Furniture/TimeLever/Plate"]
transform = Transform3D(0, 0, 1, -1, 0, 0, 0, -1, 0, 0.007, 0.1450, 0.0174)
pixel_size = 0.00075
billboard = 0
shaded = false
double_sided = false
modulate = Color(1, 0.78, 0.5, 1)
outline_modulate = Color(0.12, 0.11, 0.1, 0.85)
text = ""
font = ExtResource("52_nerdfont")
font_size = 72
outline_size = 5

[node name="TickDay" type="Label3D" parent="Furniture/TimeLever/Plate"]
transform = Transform3D(0, 0, 1, -1, 0, 0, 0, -1, 0, 0.007, 0.0602, -0.0632)
pixel_size = 0.00075
billboard = 0
shaded = false
double_sided = false
modulate = Color(1, 0.85, 0.22, 1)
outline_modulate = Color(0.12, 0.11, 0.1, 0.85)
text = ""
font = ExtResource("52_nerdfont")
font_size = 72
outline_size = 5

[node name="TickEvening" type="Label3D" parent="Furniture/TimeLever/Plate"]
transform = Transform3D(0, 0, 1, -1, 0, 0, 0, -1, 0, 0.007, -0.0568, -0.0646)
pixel_size = 0.00075
billboard = 0
shaded = false
double_sided = false
