; --- Exterior -----------------------------------------------------------------
; Real geometry beyond the north wall rather than an emissive quad. A painted
; backdrop has no parallax, so in a headset it reads as a sticker on the wall the
; moment the player leans — which is exactly what the first pass did.
;
; Everything here is low-poly and single-material: the houses are 298-776 tris
; each with ONE mesh apiece, seen from 15-25 m through a 1.5 x 1.2 m opening.
; Kenney's houses are centre-pivoted with their base at y=0, so placement is the
; plain world position — unlike the Furniture Kit's corner pivots.
;
; The window's sightline is narrow (~15 deg either side from a metre back), but
; the player can walk the room, so the street is built wide enough to survive
; looking out from an angle.
; Ground floor. This was -3.2 — the street one storey down, on the argument that
; looking DOWN puts rooftops and canopies at readable angles while a level view
; fills the window with empty tarmac. In practice it did the opposite: the room
; sits 14 m back from the kerb, so looking down filled two thirds of the window
; with flat empty LAWN and the room read as floating above the street.
;
; At eye level that same lawn compresses toward the horizon and costs a band
; instead of a third of the view, and the room sits ON something. The tarmac the
; old note warned about is real, and the answer to it is mid-ground detail —
; fences, driveways, a parked car — not altitude.
[node name="Exterior" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
script = ExtResource("10_exterior")

[node name="Ground" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.05, -40)
mesh = SubResource("Mesh_ground")
surface_material_override/0 = SubResource("Mat_ground")

[node name="Road" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.04, -20)
mesh = SubResource("Mesh_road")
surface_material_override/0 = SubResource("Mat_road")

[node name="KerbNear" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.02, -16.2)
mesh = SubResource("Mesh_kerb")
surface_material_override/0 = SubResource("Mat_aggregate")

[node name="KerbFar" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.02, -23.8)
mesh = SubResource("Mesh_kerb")
surface_material_override/0 = SubResource("Mat_aggregate")

; Houses across the road, scale 7 (a 1.3-unit model becomes a 9 m frontage,
; 8 m to the ridge for the two-storey ones). Spaced 12 m so they read as separate
; plots rather than a terrace.
[node name="HouseA" parent="Exterior" instance=ExtResource("6_house2a")]
