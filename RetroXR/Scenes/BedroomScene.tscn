[sub_resource type="Animation" id="Anim_fan_spin"]
resource_name = "spin"
length = 2.0
loop_mode = 1
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
; Spins the ROTOR, not the fixture. This used to turn FanPivot, which parents the
; whole GLB — so the glass shade, the bulb, the lamp base, the downrod and the
; ceiling canopy all revolved with the blades. Fan_Blade_Supports holds the arms
; and Fan-Blades beneath it, and its siblings (Lightbulb_Cover, Lightbulb_001,
; Lightbulb_Base, Fan_Support_Shaft, Fan_Support) are exactly the parts that must
; stay still.
;
; About local Z, not Y. The kit is a Collada export whose blades lie in their
; node's local XY plane — the blade mesh AABB is 4.6 x 4.6 wide and ~0 thick in
; Z — so Z is the shaft axis in that frame however the fixture is oriented in
; the room. Rotating about Y here would tumble the blades end over end.
tracks/0/path = NodePath("FanPivot/Fan/Sketchfab_model/Collada visual scene group/Ceiling/Fan_Center/Fan_Blade_Supports:rotation")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 2),
"transitions": PackedFloat32Array(1, 1),
"update": 0,
"values": [Vector3(0, 0, 0), Vector3(0, 0, 6.28319)]
}

[sub_resource type="AnimationLibrary" id="AnimLib_fan"]
_data = {
&"spin": SubResource("Anim_fan_spin")
}

[node name="Root" type="Node3D"]
script = ExtResource("1_xrinit")
scene_id = "bedroom"

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_bedroom")

; Two suns, split by cull mask, because shadows are OFF on Quest and an
; unshadowed DirectionalLight3D lights a room's interior as if the walls were not
; there. Indoors that means the light has to stay very dim; outdoors it needs to
; be a real golden hour. One light cannot be both.
;
;   Dusk        -> layer 1 only (the room)      energy 0.15
;   ExteriorSun -> layer 2 only (the street)    energy 1.5
;
; Scripts/Objects/room/bedroom_exterior.gd puts every renderable under Exterior on layer 2.
; sky_mode 2 is SKY_MODE_LIGHT_ONLY. A ProceduralSkyMaterial paints a sun disc for
; every one of LIGHT0..3, so an indoor fill and a blue sky fill were both smearing
; glows across a sky authored for ONE sun. Light-only also means moving these two
; no longer dirties the sky, which is what keeps a time-of-day drag cheap: the
; radiance cubemap and its mip chain rebuild whenever the sky shader's inputs change.
[node name="Dusk" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.94, -0.24, 0.24, 0, 0.7, 0.71, -0.34, -0.67, 0.66, 0, 2.2, -2.2)
light_color = Color(1, 0.72, 0.5, 1)
light_energy = 0.15
light_cull_mask = 1
sky_mode = 2

[node name="ExteriorSun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.87, -0.32, 0.37, 0, 0.76, 0.65, -0.49, -0.57, 0.66, 0, 8, -14)
light_color = Color(1, 0.74, 0.48, 1)
light_energy = 1.5
light_cull_mask = 2

; Sky fill for the street, so the shaded sides of the houses are not black.
[node name="ExteriorFill" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.87, 0.28, -0.4, 0, 0.82, 0.57, 0.49, 0.5, -0.71, 0, 8, -20)
light_color = Color(0.45, 0.55, 0.85, 1)
light_energy = 0.5
light_cull_mask = 2
sky_mode = 2

