; A trace of emission on both posters — 0.10, down from 0.30. Print has no light
; of its own, and at 0.30 the glow was adding apparent contrast to art that was
; already four times the room's saturation and eight times its luminance spread.
; Tools/gen_bedroom_art.py now runs both through print_look(), which lifts the
; blacks, caps the whites and desaturates, so they no longer need the glow to read
; at the distance they are actually seen from.
[sub_resource type="StandardMaterial3D" id="Mat_poster_a"]
albedo_texture = ExtResource("33_poster_a")
roughness = 0.9
emission_enabled = true
emission_energy_multiplier = 0.1
emission_texture = ExtResource("33_poster_a")

