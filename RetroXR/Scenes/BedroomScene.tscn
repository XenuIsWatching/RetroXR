; Late evening: warm ambient, dark warm background, filmic tonemap and the den's
; glow settings so the CRT and the lamps bloom the same way across both rooms.
; Authored here on purpose — QualityManager only LAYERS AO onto whatever
; Environment a scene brings, it never replaces it.
; Dusk sky, because the window looks onto real geometry now rather than a painted
; quad — a flat background colour would show as a dead band above the rooftops.
; ambient stays AMBIENT_SOURCE_COLOR (warm, low) so the sky does not wash the
; room's own lamplight out.
[sub_resource type="ProceduralSkyMaterial" id="Sky_dusk"]
sky_top_color = Color(0.06, 0.11, 0.3, 1)
sky_horizon_color = Color(0.78, 0.45, 0.28, 1)
sky_curve = 0.12
ground_bottom_color = Color(0.05, 0.05, 0.06, 1)
ground_horizon_color = Color(0.55, 0.35, 0.24, 1)
sun_angle_max = 24.0
sun_curve = 0.08

[sub_resource type="Sky" id="Sky_bedroom"]
sky_material = SubResource("Sky_dusk")

[sub_resource type="Environment" id="Env_bedroom"]
background_mode = 2
sky = SubResource("Sky_bedroom")
ambient_light_source = 2
ambient_light_color = Color(1, 0.84, 0.7, 1)
; DO NOT tune the room's brightness here. TimeOfDay._apply_daylight OWNS this
; property and overwrites it from its KEYS table on the first deferred apply, so
; an authored value only ever survives until the scene finishes loading — it was
; briefly raised to 0.34 here and measured 0.090 at runtime, which is the night
; key, not this number. It is the same trap as authoring energy on a
; "ceiling_light". The curve is the place to change it.
ambient_light_energy = 0.25
tonemap_mode = 2
glow_enabled = true
glow_levels/2 = 0.3
glow_levels/4 = 0.2
glow_intensity = 0.5
glow_strength = 0.7

; --- Exterior ---------------------------------------------------------------
[sub_resource type="PlaneMesh" id="Mesh_ground"]
size = Vector2(140, 140)

; Lawn (ambientCG Grass005, tagged clean/lawn/short). This was a flat
; Color(0.11, 0.14, 0.09) over a 140 x 140 plane, and it is the single biggest
; surface in the window: from a metre back it filled the lower third of the view
; with nothing at all.
;
; The tint is doing real work, not decoration. bedroom_exterior.gd::_tone_down()
; desaturates and darkens every GLB out here to 0.62, but it SKIPS surfaces that
; already carry an override — which this does. Left at full strength a
; photographic lawn sits at full saturation beside houses muted to 0.62 and the
; two stop belonging to the same street, so the muting is baked in here instead.
[sub_resource type="ShaderMaterial" id="Mat_ground"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("57_grass_col")
shader_parameter/roughness_tex = ExtResource("59_grass_rgh")
shader_parameter/normal_tex = ExtResource("58_grass_nrm")
shader_parameter/ao_tex = ExtResource("60_grass_ao")
shader_parameter/tint = Color(0.5, 0.56, 0.42, 1)
shader_parameter/paint_over = 0.0
shader_parameter/tiles_per_metre = 0.4
shader_parameter/normal_strength = 0.8
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = false
shader_parameter/swap_uv = false
shader_parameter/uv_offset = Vector2(0, 0)
shader_parameter/ao_enabled = true
shader_parameter/ao_strength = 0.6
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.0
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.0

[sub_resource type="BoxMesh" id="Mesh_road"]
size = Vector3(90, 0.04, 6.5)

; Tarmac with its lane markings in the texture (ambientCG Road007): two solid
; edge lines and a dashed centre line, so the road needs no extra geometry to be
; marked out.
;
; That content is why this material is fiddlier than the lawn. The tile has to
; land ACROSS the road exactly once, with the boundary on the kerb:
;   swap_uv    - the axis pick gives (x, z) for an up-facing surface, i.e. length
;                then width, and the tile runs width then length. Swapped.
;   0.153846   - 1/6.5, one tile across the road's 6.5 m width. Along its 90 m
;                length it then repeats every 6.5 m, which is what the dashes are
;                for.
;   uv_offset  - world UVs count from the world origin, and this road spans
;                z -23.25..-16.75, so without an offset the tile seam would fall
;                mid-tarmac and the edge lines would run down the lanes.
;                23.25 * 0.153846 = 3.5769 puts U = 0 exactly on the far kerb.
; Exposed aggregate — the driveway, the front walk and BOTH sidewalks.
;
; ambientCG has nothing tagged "aggregate" (the search returns zero), so this was
; picked by looking at previews rather than trusting tags: Rocks022 is filed
; under gravel and pebbles, and is textbook exposed aggregate — rounded stones
; set densely in mortar, which is the finish a 90s drive and sidewalk actually
; have. Its AmbientOcclusion map earns its place for the same reason it did on
; the carpet and the lawn: pebble-in-mortar is exactly the deep micro-relief a
; tiling AO describes.
;
; tiles_per_metre sets the stone size and is a render check rather than
; arithmetic — 1.7 puts one tile per 0.59 m, which lands the pebbles around
; 20 mm. Judged from a camera over the drive, not from the window.
[sub_resource type="ShaderMaterial" id="Mat_aggregate"]
shader = ExtResource("56_roomsurf")
shader_parameter/albedo_tex = ExtResource("75_agg_col")
shader_parameter/roughness_tex = ExtResource("77_agg_rgh")
shader_parameter/normal_tex = ExtResource("76_agg_nrm")
shader_parameter/ao_tex = ExtResource("78_agg_ao")
shader_parameter/tint = Color(0.6, 0.61, 0.6, 1)
shader_parameter/paint_over = 0.0
shader_parameter/tiles_per_metre = 1.7
shader_parameter/normal_strength = 1.0
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = false
shader_parameter/swap_uv = false
shader_parameter/uv_offset = Vector2(0, 0)
shader_parameter/ao_enabled = true
shader_parameter/ao_strength = 0.75
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.0
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.0

