[node name="MovementDirect" parent="Staging/XROrigin3D/LeftController" instance=ExtResource("5_movdirect")]
max_speed = 1.4
strafe = true

; Both ways of getting around live on the LEFT stick, and LocomotionManager
; keeps exactly one of them enabled (AppPrefs.locomotion_teleport chooses).
; Teleport used to sit on the right controller, where pushing the stick forward
; to aim fought snap-turn and read as an accidental jump.
[node name="FunctionTeleport" parent="Staging/XROrigin3D/LeftController" instance=ExtResource("7_teleport")]
script = ExtResource("8_stickteleport")
stick_teleport_action = "primary"
stick_teleport_threshold = 0.6
teleport_button_action = ""

