[sub_resource type="PhysicsMaterial" id="PhysMat_box"]
friction = 0.8

; A small open-top cardboard box, built from primitives rather than a downloaded
; shell. The open top is load-bearing, not cosmetic: TrashArea has to sit in free
; space over the mouth for get_overlapping_bodies() to catch a released pickable,
; so a lidded box would silently break drop-to-delete.
;
; The body is hollow — a base and four wall shapes, not one solid block — so an
; object dropped in falls INTO it and sits there for the moment before it
; shrinks away.
[node name="StorageBox" type="RigidBody3D" groups=["spawned"]]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_box")
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_boxscript")

