[ext_resource type="Texture2D" path="res://imported-assets/shared/materials/Cardboard004_1K-JPG_Color.jpg" id="4_card_col"]
[ext_resource type="Texture2D" path="res://imported-assets/shared/materials/Cardboard004_1K-JPG_NormalGL.jpg" id="5_card_nrm"]
[ext_resource type="Texture2D" path="res://imported-assets/shared/materials/Cardboard004_1K-JPG_Roughness.jpg" id="6_card_rgh"]

; --- Cardboard, on pbr_surface.gdshader -------------------------------------
; The table's prop recipe, for the table's reasons: object_space, because the
; box is a RigidBody the player carries between rooms and in world space the
; corrugation would swim across it as it moved; contact_strength 0, because the
; shader's corner darkening measures against a ROOM's extents and on a moving
; prop that is a stain sliding over it.
;
; tiles_per_metre is 3.0 rather than the table's 0.9. This is a 0.34 m box, and
; at the table's density a single flute would cover a whole wall.
;
; The tint lifts BLUE rather than warming the map. A tint can only multiply, and
; this set's albedo is already a strong orange — measured off a render, the wall
; came back at saturation 0.61, where corrugated board sits nearer 0.30. Warming
; it further only deepened that, so the multiplier holds red back instead.
[sub_resource type="ShaderMaterial" id="Mat_card"]
shader = ExtResource("3_pbr")
shader_parameter/albedo_tex = ExtResource("4_card_col")
shader_parameter/roughness_tex = ExtResource("6_card_rgh")
shader_parameter/normal_tex = ExtResource("5_card_nrm")
shader_parameter/tint = Color(0.72, 0.78, 1, 1)
shader_parameter/paint_over = 0.0
shader_parameter/tiles_per_metre = 3.0
shader_parameter/normal_strength = 1.0
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = true
shader_parameter/swap_uv = false
shader_parameter/ao_enabled = false
shader_parameter/ao_strength = 1.0
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.0
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.0

; The inside of the box, on thin liner panels a couple of millimetres in from
; the walls. Same cardboard, darker: an open box is a cavity, and with the
; shader's contact darkening off for props and no shadows at all on Quest,
; nothing else would tell the inner faces from the outer ones — the box would
; read as a solid block with a painted-on mouth. The depth is authored.
[sub_resource type="ShaderMaterial" id="Mat_card_inner"]
shader = ExtResource("3_pbr")
shader_parameter/albedo_tex = ExtResource("4_card_col")
shader_parameter/roughness_tex = ExtResource("6_card_rgh")
shader_parameter/normal_tex = ExtResource("5_card_nrm")
shader_parameter/tint = Color(0.4, 0.43, 0.55, 1)
shader_parameter/paint_over = 0.0
shader_parameter/tiles_per_metre = 3.0
shader_parameter/normal_strength = 1.0
shader_parameter/roughness_scale = 1.0
shader_parameter/object_space = true
shader_parameter/swap_uv = false
shader_parameter/ao_enabled = false
shader_parameter/ao_strength = 1.0
shader_parameter/room_half_extent = Vector2(2.525, 2.125)
shader_parameter/floor_y = 0.0
shader_parameter/ceiling_y = 2.6
shader_parameter/contact_strength = 0.0
shader_parameter/contact_distance = 0.45
shader_parameter/corner_boost = 0.0

