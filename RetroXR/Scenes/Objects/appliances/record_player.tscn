; The platter TURNS. The seated record is turned alongside it from the same angular
; velocity rather than being parented to it — see MediaSlot below for why.
[node name="Platter" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.038, 0)

[node name="PlatterMesh" type="MeshInstance3D" parent="Platter"]
mesh = SubResource("Cyl_platter")
surface_material_override/0 = SubResource("Mat_platter")

[node name="Spindle" type="MeshInstance3D" parent="Platter"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.014, 0)
mesh = SubResource("Cyl_spindle")
surface_material_override/0 = SubResource("Mat_spindle")

; A DIRECT child of the deck, named exactly this: RetroAudioPlayer resolves it as
; $MediaSlot. It deliberately does NOT ride the platter — a seated record is spun
; by the deck instead, the way the CD player spins a disc, so that this node stays
; where the base and the net layer expect to find it.
[node name="MediaSlot" parent="." instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.047, 0)
grab_distance = 0.12
snap_require = "vinyl_record"

[node name="SnapHighlight" type="Node3D" parent="MediaSlot"]
script = ExtResource("4_snaphis")

[node name="HighlightMesh" type="MeshInstance3D" parent="MediaSlot/SnapHighlight"]
mesh = SubResource("Cyl_record_ghost")
surface_material_override/0 = SubResource("Mat_record_ghost")

; Where a fingertip is tested against the record. Does NOT ride the platter — it is
; the fixed frame the hand's angle is measured in, and spinning it would cancel out
; exactly the rotation being measured.
[node name="PlatterPoke" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.048, 0)
collision_layer = 0
collision_mask = 0

; ARM MOUNT. Its basis is the whole trick: VRHinge writes target.rotation.x and
; measures the hand in the pivot's own rest frame, so a tonearm — which swings about
; VERTICAL — needs a frame whose local X points along the deck's up axis. That is
; R_z(+90): local X -> +Y. Listed by ROWS here, as .tscn always does.
; The pivot below stays IDENTITY; the basis lives here, on the mount above it.
;
; The pivot sits 297 mm from the spindle with a 260 mm arm, and those two numbers
; are not free. The stylus traces a circle of radius L about the pivot, so what the
; pair decides is the band of the record it can reach: here 141 mm from the spindle
; at 25.6 deg down to 54 mm at 45.9 deg, i.e. the outer groove to just outside the
; label. An arm as long as the pivot distance sweeps THROUGH the spindle and lands
; on the far side of the record instead, which is what the first cut of this did.
[node name="ArmMount" type="Node3D" parent="."]
transform = Transform3D(0, 1, 0, 1, 0, 0, 0, 0, -1, 0.185, 0.078, -0.175)

; The post, from the plinth top up to the arm. Its own basis undoes the mount's so
; the cylinder stands upright; -0.024 on mount-local X is 24 mm DOWN, that axis
; being the deck's up.
[node name="ArmBase" type="MeshInstance3D" parent="ArmMount"]
transform = Transform3D(0, 1, 0, -1, 0, 0, 0, 0, 1, -0.024, 0, 0)
mesh = SubResource("Cyl_armbase")
surface_material_override/0 = SubResource("Mat_arm")

[node name="ArmPivot" type="Node3D" parent="ArmMount"]

; The arm runs out along the pivot's local -Z, which is the deg = 0 direction.
[node name="ArmTube" type="MeshInstance3D" parent="ArmMount/ArmPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.13)
mesh = SubResource("Box_armtube")
surface_material_override/0 = SubResource("Mat_arm")

; The headshell hangs below the tube, down to just clear of the record. That drop is
; on the pivot's local X — the axis the arm turns ABOUT — so it is a constant height
; at every swing angle. On local Y it would move the headshell SIDEWAYS instead, and
; leave the stylus buried under the record, which is what it did at first.
; The bend from the tube down to the headshell. Without it the headshell reads as a
; box floating beside the arm rather than hanging off the end of it.
[node name="HeadDrop" type="MeshInstance3D" parent="ArmMount/ArmPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.013, 0, -0.254)
mesh = SubResource("Box_headdrop")
surface_material_override/0 = SubResource("Mat_arm")

[node name="Headshell" type="MeshInstance3D" parent="ArmMount/ArmPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.026, 0, -0.253)
mesh = SubResource("Box_headshell")
surface_material_override/0 = SubResource("Mat_arm")

; The lever sits ON the headshell, not at the pivot: VRHinge measures tip proximity
; from its own origin, so one parked at the hub would arm when a hand came near the
; base instead of near the end you actually take hold of. Child of the pivot, so it
; rides the arm round.
;
; deg 0 is the rest, clear of the record; -46 is the run-out groove. The throw is
; negative because the mount is composed with a half turn to put the arm's deg-0
; direction at the FRONT of the deck, which flips the sweep's sign — so value_at_min
; 1 / value_at_max 0 is what keeps value 0 = parked.
[node name="TonearmLever" type="Area3D" parent="ArmMount/ArmPivot" node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.016, 0, -0.245)
collision_layer = 0
collision_mask = 0
script = ExtResource("6_vrlever")
target = NodePath("..")
min_deg = -46.0
max_deg = 0.0
engage_radius = 0.05
value_at_min = 1.0
value_at_max = 0.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="ArmMount/ArmPivot/TonearmLever"]
shape = SubResource("Shape_armgrab")

; Where the arm sits at deg 0. A rest under the parked stylus, so "parked" reads as
; a place the arm belongs rather than as the arm stopping in mid-air.
[node name="ArmRest" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.185, 0.038, 0.085)
mesh = SubResource("Cyl_armrest")
surface_material_override/0 = SubResource("Mat_arm")

; The nameplate, flat on the plinth's FRONT face (+Z, the side the transport is on)
; rather than floating over the deck. Identity basis because a Label3D already faces
; +Z; 1 mm proud of the 0.2 m face so it cannot z-fight the plinth.
[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.004, 0.2012)
pixel_size = 0.001
text = "RECORD PLAYER"
font_size = 28
outline_size = 6

