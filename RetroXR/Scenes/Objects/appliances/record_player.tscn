; 33/45. steps = 2 makes it a detented slide switch rather than a continuous slider.
; It sets the platter's speed and nothing else: playing a record at the wrong speed
; would need a playback-rate API, and vlc-godot exposes none.
[node name="SpeedSwitch" type="Area3D" parent="." node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.045, 0.03, 0.165)
collision_layer = 0
collision_mask = 0
script = ExtResource("7_vrslider")
target = NodePath(".")
axis_local = Vector3(1, 0, 0)
travel = 0.016
steps = 2
engage_radius = 0.03

; VRSlider._adopt_knob_collision takes the first CollisionShape3D child and makes it
; ride the knob, so the player aims at the switch wherever it has slid to.
[node name="CollisionShape3D" type="CollisionShape3D" parent="SpeedSwitch"]
shape = SubResource("Shape_knobgrab")

[node name="KnobMesh" type="MeshInstance3D" parent="SpeedSwitch"]
mesh = SubResource("Box_knob")
surface_material_override/0 = SubResource("Mat_arm")

