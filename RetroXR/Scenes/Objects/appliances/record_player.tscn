; The grab volumes. VRHinge/VRSlider engage a FINGERTIP by proximity to their own
; origin and need no shape for that, which is why the arm works in VR without one —
; but the desktop reticle is an intersect_ray against the pointable layer, and a ray
; cannot hit a shapeless Area3D. Without these the arm and the speed switch are
; simply not grabbable on desktop.
[sub_resource type="SphereShape3D" id="Shape_armgrab"]
radius = 0.028

; Sized off the KNOB (16 x 12 x 22 mm) with the margin the authored switches use,
; and — the load-bearing part — WIDER along the travel axis than the throw itself.
; The shape rides the knob while the desktop drag maps the ray's hit ABSOLUTELY, so
; a box narrower than the travel can only ever be hit at the end it already sits at:
; the switch reaches 45 and there is no longer any point a ray can land on that maps
; back to 33. Wider than the throw, the box still reaches across the mid-point from
; either end, which is what lets a pointer flip it back.
[sub_resource type="BoxShape3D" id="Shape_knobgrab"]
size = Vector3(0.028, 0.018, 0.028)

[sub_resource type="BoxMesh" id="Box_knob"]
size = Vector3(0.016, 0.012, 0.022)

[node name="RecordPlayer" type="RigidBody3D" groups=["record_player"]]
