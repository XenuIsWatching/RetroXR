; Laser target, deliberately wider than the physics sphere — a plug is a small
; thing to hit with a beam from across the room, and this shape only answers the
; pointer (mask 0).
[sub_resource type="SphereShape3D" id="SphereShape3D_pointer"]
radius = 0.032

; The Multi Out shell is 27 x 15 x 30 mm against a phono plug's 8 mm barrel, so it
; gets its own pair. Sized to the SHROUD rather than to the whole plug: the 13 mm
; tongue is inside the console whenever the connector matters, and a sphere covering
; it would let the shell be grabbed through the back panel.
[sub_resource type="SphereShape3D" id="SphereShape3D_wiiplug"]
radius = 0.017

[sub_resource type="SphereShape3D" id="SphereShape3D_wiipointer"]
radius = 0.024

; A Wii A/V lead: ONE AV Multi Out at the console end, three phonos at the set.
;
; The console end is a SHARED end — one connector carrying all three cords — which
; is why this scene ships four plugs for three cords. CompositeCable counts from the
; longer side and treats the short one as shared; which signal each cord carries is
; then WiiAvPort.channel_for's business, not the plug's. See both.
;
; Everything else is composite_cable.tscn: same cords, same colours, same rope, and
; the same rule that what a cord carries is decided by the two sockets its ends sit
; in. Run the yellow plug into the set's white socket and you get exactly what that
; does on the real hardware.
; GREY jacket, not the black every other lead in the room wears. Nintendo moulded
; this one to match the console, so the cord is the same grey as the Multi Out shroud
; it leaves — the value is gen_wii_av.gd's SHROUD_GREY, and the two have to be changed
; together or the cord will read as a different part from the connector on its end.
;
; cord_colors is untouched: the three phonos at the far end stay yellow, white and
; red, because the real lead colour-codes its CONNECTORS and not its sheath. That is
; the same split composite_cable.tscn documents.
;
; `script` FIRST, then the export. Properties are applied in file order and an
; exported one does not exist until the script is attached, so a wire_color written
; above this line is silently dropped and the lead comes back black.
[node name="WiiAvCable" type="Node3D"]
script = ExtResource("1_cablescript")
wire_color = Color(0.46, 0.46, 0.44, 1.0)

; ── End A: the AV Multi Out ─────────────────────────────────────
; Turned about Y so the cord trails toward the far end: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
; On the centreline, unlike the phono ends — there is nothing to spread it against.

[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.75)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.05
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("6_wiiplugscript")

; The colliders sit on the BODY, not on the origin. This connector's origin is its
; MATING face — the frame a snap zone seats to — and the whole moulding lies BEHIND
; it, so a shape left at the origin ends up half buried in the console while the part
; a hand reaches for carries nothing. That is exactly what happened when the stand-in
; cylinder, which sat in FRONT of its origin, was swapped for the real mesh: the plug
; became ungrabbable the moment it was plugged in.
[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.015)
shape = SubResource("SphereShape3D_wiiplug")

[node name="PlugTip" type="MeshInstance3D" parent="PlugA0"]
mesh = ExtResource("7_wiiplugmesh")

[node name="PointerArea" type="StaticBody3D" parent="PlugA0"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.015)
