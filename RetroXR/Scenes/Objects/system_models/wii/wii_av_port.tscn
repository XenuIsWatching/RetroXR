[gd_scene load_steps=5 format=3]

[ext_resource type="PackedScene" uid="uid://ce7vysyvondf8" path="res://addons/godot-xr-tools/objects/snap_zone.tscn" id="1_snapzone"]
[ext_resource type="Script" path="res://Scripts/Objects/cables/wii_av_port.gd" id="2_portscript"]
[ext_resource type="PackedScene" path="res://Scenes/Objects/system_models/wii/wii_av_jack.tscn" id="3_wiiavjack"]
[ext_resource type="Script" path="res://Scripts/Objects/highlights/snap_highlight.gd" id="4_snaphigh"]

; The shroud's own block, so the ghost reads as "the grey Wii plug goes here" rather
; than as a generic glowing box.
[sub_resource type="BoxMesh" id="BoxMesh_plug_ghost"]
size = Vector3(0.027, 0.015, 0.03)

[sub_resource type="StandardMaterial3D" id="Mat_plug_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.45)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

; A socket, placed the way rca_port.tscn places its own: the ZONE sits where a seated
; plug's ORIGIN belongs and the jack is pushed back by that much so its panel face
; lands on the case. Copy this node's transform from an existing port and the plug
; still seats right.
;
; 2 mm, not the RCA pair's 10 or the VGA pair's 7.5. A seated Multi Out plug's origin
; is its shroud face, and the 27 x 15 shroud is WIDER than the 23.5 x 12 bezel, so it
; cannot enter — it stops flat on the bezel's own 2 mm face. See the MATING note in
; Tools/gen/gen_wii_av.gd. Use another connector's number and the plug floats off the back
; of the console or sinks into it.
; grab_distance is the zone's REACH, and it is drawn as a sphere of that radius — the
; green ball CollisionDebug puts on the back panel.
;
; 25 mm, not the 60 every phono socket uses. That number came off rca_port.tscn, where
; it suits a jack on a full-size deck with nothing near it; on this panel it reached
; 46 mm further out than the SENSOR BAR socket sitting 14 mm away, so a ray aimed at
; anything down there hit THIS zone first. Being empty, it then swallowed the click
; whole — the pickup classifier gives up when its front hit is a socket holding
; nothing, rather than looking past it — and the sensor plug could not be grabbed at
; all. Roughly a plug's width, which is as much catch as a 23.5 x 12 mm socket wants.
[node name="WiiAvPort" instance=ExtResource("1_snapzone")]
grab_distance = 0.025
script = ExtResource("2_portscript")

[node name="WiiAvJack" parent="." instance=ExtResource("3_wiiavjack")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.002)

[node name="SnapHighlight" type="Node3D" parent="."]
script = ExtResource("4_snaphigh")

; Back along -Z from the mating face, which is where the shroud actually sits.
[node name="HighlightMesh" type="MeshInstance3D" parent="SnapHighlight"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.015)
mesh = SubResource("BoxMesh_plug_ghost")
surface_material_override/0 = SubResource("Mat_plug_ghost")
