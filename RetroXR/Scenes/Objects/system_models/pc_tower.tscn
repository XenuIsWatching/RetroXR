; Where a floppy sits in the 3.5 in drive — the seat for every machine this tower
; stands in for EXCEPT scummvm, whose games are on CD and belong in the tray below.
; A disk is media, not a disc, so it must never be seated in the optical well: that
; well is inside the case at rest, and a cartridge snapped into it disappears.
;
; Basis is R_x(-90): the disk lies FLAT with its label up, its title readable from
; in front of the machine, and its shutter leading. A floppy carries that shutter on
; the cart frame's +Y (see _apply_floppy_shell), which is what lets one X rotation
; do all three at once. The NES cradle's basis — the other way media is
; laid flat here — inverts X, because a cartridge's connector is at -Y and mapping
; THAT into the machine while keeping the label up is only a rotation if X flips;
; borrowing it for a disk seats the title mirrored.
;
; z 0.2415: the slit's face is at 0.2345 and the snap zone seats media by its
; CENTRE, so a 94 mm disk bitten 40 mm deep centres 7 mm behind that face and
; stands 54 mm out in front of the bezel — far enough to read the label across the
; room and to take hold of without reaching into the case.
[node name="FloppySeat" type="Marker3D" parent="Front"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, 0, 0.268, 0.2415)

; Anchors, not geometry — RetroSystem's own VRButtons are moved onto these, so the
; button meshes it already carries are the visible caps.
[node name="PowerButtonAnchor" type="Marker3D" parent="Front"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.042, 0.122, 0.234)

; On the drive faceplate to the RIGHT of the slit, not inside it — at x 0.058 with
; a 0.152-wide slit the button floated in the opening.
[node name="EjectButtonAnchor" type="Marker3D" parent="Front"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.064, 0.331, 0.234)

; --- the sliding tray --------------------------------------------------------
; TrayPivot is what pc_tower_model.gd translates along +Z, and what RetroSystem
; reparents a seated disc to, so the disc rides out of the bay with it. At rest the
; tray is INSIDE the case; only its front lip shows in the bay slot — z 0.159 puts
; that lip 8.5 mm behind the slit face.
[node name="TrayPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.012, 0.335, 0.159)

[node name="Shelf" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.018, 0)
mesh = SubResource("Mesh_tray")
surface_material_override/0 = SubResource("Mat_tray")

[node name="Well" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0125, 0)
mesh = SubResource("Mesh_well")
surface_material_override/0 = SubResource("Mat_dark")

[node name="Spindle" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.009, 0)
mesh = SubResource("Mesh_spindle")
