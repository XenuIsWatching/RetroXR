; A 90s beige mini-tower: 0.19 W x 0.42 H x 0.44 D, which is a real ATX mini-tower
; footprint. Origin at the base centre, so the system sits on the floor at y 0.
[sub_resource type="BoxMesh" id="Mesh_case"]
size = Vector3(0.19, 0.42, 0.44)

; The front bezel stands 6 mm proud of the case so its edge catches light, the same
; trick the wardrobe's door panels use.
[sub_resource type="BoxMesh" id="Mesh_bezel"]
size = Vector3(0.192, 0.42, 0.012)

; 136 mm slit — a 5.25 in bay has to swallow a 130 mm tray. Was 116 mm, narrower
; than the 120 mm disc it is supposed to pass.
[sub_resource type="BoxMesh" id="Mesh_bay"]
size = Vector3(0.136, 0.035, 0.008)

[sub_resource type="BoxMesh" id="Mesh_floppy"]
size = Vector3(0.104, 0.012, 0.008)

; The tray, sized against the 120 mm disc it carries: 5 mm margin at the sides,
; 7 mm front and back. It used to be 112 x 160 — NARROWER than the disc, so the
; disc overhung the shelf by 4 mm a side, and 40 mm longer than it, which is the
; gap that showed between the disc edge and the tray edge.
[sub_resource type="BoxMesh" id="Mesh_tray"]
size = Vector3(0.130, 0.007, 0.134)

; 124 mm well: 2 mm clearance round the disc. At 108 mm the disc overhung its own
; recess by 6 mm a side and sat on the rim rather than in it.
[sub_resource type="CylinderMesh" id="Mesh_well"]
top_radius = 0.062
bottom_radius = 0.062
height = 0.004

[sub_resource type="CylinderMesh" id="Mesh_spindle"]
top_radius = 0.008
bottom_radius = 0.008
height = 0.007

[sub_resource type="BoxMesh" id="Mesh_led"]
size = Vector3(0.008, 0.004, 0.004)

; Beige, and grubby-warm rather than clean grey — a 90s case yellowed.
[sub_resource type="StandardMaterial3D" id="Mat_beige"]
albedo_color = Color(0.77, 0.73, 0.63, 1)
roughness = 0.62

[sub_resource type="StandardMaterial3D" id="Mat_bezel"]
