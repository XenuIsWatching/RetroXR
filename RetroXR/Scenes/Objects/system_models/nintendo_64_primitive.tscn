[ext_resource type="Script" path="res://Scripts/Objects/system_models/nintendo_64_model.gd" id="1_n64"]

; 260 x 190 mm on the table, 73 mm to the top of the deck -- the real machine's
; figures. A low base with a raised central deck running front to back: the
; cartridge mouth at the back of that deck, the Expansion Pak well in front of
; it, POWER and RESET straddling the deck.
;
; The cartridge mouth is the CARTRIDGE's own footprint and nothing more:
; MediaDimensions has the N64 cart at 116 x 75 x 20 mm, so the slot is 122 x 24
; -- the width of the cart by its THICKNESS. It is a letterbox, not a square
; hatch.
;
; The well is a SHAFT, not a tray, which is why the base is split. A 46 mm pak
; against 28 mm of deck means the hole carries on down through the base: 50 mm
; from the rim at 0.073 to the floor at 0.023. A BoxMesh cannot have a hole in
; it, so the base is four boxes around the shaft above y 0.023 and one solid
; slab below.
[sub_resource type="BoxMesh" id="Mesh_base_lower"]
size = Vector3(0.26, 0.023, 0.19)

[sub_resource type="BoxMesh" id="Mesh_base_side"]
size = Vector3(0.103, 0.022, 0.19)

[sub_resource type="BoxMesh" id="Mesh_base_rear"]
size = Vector3(0.054, 0.022, 0.115)

[sub_resource type="BoxMesh" id="Mesh_base_front"]
size = Vector3(0.054, 0.022, 0.049)

[sub_resource type="StandardMaterial3D" id="Mat_body"]
albedo_color = Color(0.53, 0.54, 0.57, 1)
roughness = 0.5

[sub_resource type="StandardMaterial3D" id="Mat_deck"]
albedo_color = Color(0.5, 0.51, 0.54, 1)
roughness = 0.5

