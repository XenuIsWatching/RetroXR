[node name="ExpansionBay" type="Node3D" parent="."]

; Bottom of the shaft. 2 mm thick with its TOP face at 0.023, so a 46 mm pak
; standing on it finishes at 0.069 -- 4 mm shy of the deck, the lid's thickness.
[node name="WellFloor" type="MeshInstance3D" parent="ExpansionBay"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.022, 0.033)
mesh = SubResource("Mesh_well_floor")
surface_material_override/0 = SubResource("Mat_dark")

; The socket stands a unit ON this plane -- it lands its origin half a body
; height above the seat -- so this is the shaft FLOOR, not the pak's centre.
; Measured: seated from 0.046 here, a 46 mm pak came to rest at 0.069 with its
; top 19 mm clear of the deck.
[node name="ExpansionSeat" type="Marker3D" parent="ExpansionBay"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.023, 0.033)

