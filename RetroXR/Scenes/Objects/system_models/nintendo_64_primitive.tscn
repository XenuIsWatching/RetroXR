[node name="Rear" type="Node3D" parent="."]

; A/V OUT. The back face of the base is at z -0.095, and a phono socket seats
; 10 mm PROUD of the panel it sits in -- rca_port pushes its jack back by that
; much so the flange lands on the face -- hence -0.105 and not -0.095. y 0.020
; keeps the row inside the 45 mm base, clear of the deck above.
;
; Not the real machine's rear order: an N64 has one AV MULTI OUT shell here, not
; three phono jacks, and this model wears the three the cabinet builds.
[node name="AvSeat1" type="Marker3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.018, 0.02, -0.105)

[node name="AvSeat2" type="Marker3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, -0.105)

[node name="AvSeat3" type="Marker3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.018, 0.02, -0.105)
