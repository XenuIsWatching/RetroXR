[ext_resource type="Script" path="res://Scripts/Objects/system_models/nintendo_64_model.gd" id="1_n64"]

; 260 x 190 mm on the table, 73 mm to the top of the deck -- the real machine's
; figures. A low base with a raised central deck running front to back: the
; cartridge mouth at the back of that deck, the Expansion Pak well in front of
; it, POWER and RESET on the strip in front of both.
;
; The cartridge mouth is the CARTRIDGE's own footprint and nothing more:
; MediaDimensions has the N64 cart at 116 x 75 x 20 mm, so the slot is 122 x 24
; -- the width of the cart by its THICKNESS. It is a letterbox, not a square
; hatch; sizing it by eye instead gave an 84 x 56 hole you could have posted the
; whole cartridge down flat. The deck has to be wider than the cart for the same
; reason, hence 150 mm across rather than 110.
[sub_resource type="BoxMesh" id="Mesh_base"]
size = Vector3(0.26, 0.045, 0.19)

