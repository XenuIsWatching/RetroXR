; A/V IN — four of them, printed Composite 1 to Composite 4 and selected by SOURCE.
; CompositePort keeps its name and its place: a console's captive lead still plugs
; in here, netplay and the save file name it, and tv.gd still reaches it as
; $CompositePort. The rest are numbered from 2, and tv.gd walks all four by index.
;
; The row runs along -X at AV_ROW_PITCH within a group and AV_GROUP_PITCH between
; them, y unchanged. The stock body is a plain box, so every socket lands on the
; same flat panel; a fitted shell re-seats the whole bank off its PortSeat instead
; (see tv_shell.gd's av_socket_step / av_group_step, which were chosen by raycasting
; each cabinet's real back).
[node name="CompositePort" parent="." unique_id=-1294967295 instance=ExtResource("10_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.15, -0.15, -0.16002099)
channel = 0
direction = 1

; L and R in, beside the video socket. Sound only reaches the set through these:
; a cord from a deck's L to this one carries the left channel, and a cord from the
; deck's L to the R socket puts the left channel out of the right-hand speaker.
[node name="AudioLIn" parent="." unique_id=42071297 instance=ExtResource("10_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.132, -0.15, -0.16002099)
channel = 1
direction = 1

[node name="AudioRIn" parent="." unique_id=435405895 instance=ExtResource("10_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.114, -0.15, -0.16002099)
channel = 2
direction = 1

