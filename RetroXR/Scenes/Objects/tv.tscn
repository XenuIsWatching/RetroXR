[node name="AudioRIn4" parent="." unique_id=771000209 instance=ExtResource("10_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, -0.066, -0.15, -0.16002099)
channel = 2
direction = 1

; The aerial socket, Source.RF. One group pitch past Composite 4 and then one socket
; pitch further, which puts it on that slot's CENTRE — where a composite group centres
; its printing — rather than where a trio's VIDEO jack would go. Standing it on the
; jack position instead laid its plate 18 mm right of the pattern, far enough to
; overlap Composite 4's and z-fight with it. _seat_av_row applies the same two steps
; on a fitted cabinet so the two agree.
;
; Unlike the VGA socket this is always on: every television has an aerial hole, and
; it is what an RF switch — the way an NES reaches a set — plugs into. Its 10 mm
; standoff happens to match the phono row's, so it shares the row's Z.
;
; Its printing is an AvLegend like every other socket group's — wordless, titled
; Antenna, headed RF IN. See RetroTV._print_rf_legend, which also explains why the
; label it used to carry as a child is gone: a legend measures its own plate around
; its own text, and a hand-placed label the plate knows nothing about either hangs
; off the top of one or forces it to be sized by hand.
[node name="RfPort" parent="." unique_id=771000210 instance=ExtResource("12_coaxport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, -0.108, -0.15, -0.16002099)
direction = 1

; VGA in — a computer monitor's input, not a television's. OFF as authored: a shell
; opts in by carrying a VgaPortSeat marker and only crt_plain.tscn does, so the
; wood-cabinet sets and the stock body never grow a DE-15 socket. tv.gd seats and
; enables it when the marker is there (see _seat_vga_port).
;
; BOTH flags matter. Hiding a snap zone stops it drawing and nothing else, so a
; socket left enabled behind visible=false goes on grabbing plugs out of the air.
;
; No `channel`: VgaPort pins it to VIDEO. direction = 1 is IN — a set is a sink.
[node name="VgaPort" parent="." unique_id=778419001 instance=ExtResource("11_vgaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, -0.17, -0.15, -0.16002099)
visible = false
enabled = false
direction = 1

