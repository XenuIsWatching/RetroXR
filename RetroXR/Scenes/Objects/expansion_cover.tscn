[ext_resource type="Script" path="res://Scripts/Objects/expansion_cover.gd" id="1_cover"]
[ext_resource type="Script" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="2_pickhigh"]

; Sized to FILL the mouth of the N64's bay well rather than to sit on top of it:
; the real lid is flush with the case, so the panel is the size of the opening
; and 4 mm thick, which drops its top face level with the rim at y 0.073.
;
; 52 x 24 against a 54 x 26 mouth -- a millimetre of clearance each side, so the
; lid drops in without its faces landing in the well walls' own planes.
[sub_resource type="BoxShape3D" id="BoxShape3D_cover"]
size = Vector3(0.052, 0.004, 0.024)

[sub_resource type="BoxMesh" id="BoxMesh_cover"]
size = Vector3(0.052, 0.004, 0.024)

; The LOOSE pointer target: the lid plus a margin on every face, so a small flat
; thing is still findable once it has been put down on a shelf somewhere. Same
; reasoning as memory_card.tscn's.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.072, 0.026, 0.044)

[sub_resource type="StandardMaterial3D" id="Mat_cover"]
albedo_color = Color(0.44, 0.45, 0.48, 1)
roughness = 0.55

