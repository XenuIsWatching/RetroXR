[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.65, 0)
shape = SubResource("BoxShape3D_table")

; The four legs each carry their own shape. As inline arcade scenery the table
; had the top slab above and nothing else, so the space between the legs was
; open in every direction — you could walk through them, and anything set down
; beside the table slid under it. These are what make it solid to the floor.
[node name="LegColFL" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 0.35, 0.35)
shape = SubResource("BoxShape3D_table_leg")

