[sub_resource type="BoxMesh" id="BoxMesh_table_leg"]
size = Vector3(0.05, 0.7, 0.05)

[sub_resource type="PhysicsMaterial" id="PhysMat_table"]
bounce = 0.0
friction = 0.9

; Origin sits on the floor: the legs run y 0 -> 0.7 and the top face lands at
; 0.75, so the table stands on whatever surface it is released against instead
; of sinking half-way into it.
[node name="Table" type="RigidBody3D" groups=["spawned"]]
mass = 15.0
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_table")
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_tablescript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.65, 0)
shape = SubResource("BoxShape3D_table")

; The four legs each carry their own shape. As inline arcade scenery the table
; had the top slab above and nothing else, so the space between the legs was
; open in every direction — you could walk through them, and anything set down
; beside the table slid under it. These are what make it solid to the floor.
[node name="LegColFL" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 0.35, 0.35)
shape = SubResource("BoxShape3D_table_leg")

