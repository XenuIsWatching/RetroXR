[sub_resource type="PhysicsMaterial" id="PhysMat_pak"]
friction = 0.8

; The Rumble Pak (NUS-013): a neck that fills the expansion bay and a fat
; battery box below it holding two AAAs. That bulge is the whole silhouette of
; the thing, and it is why this pak is longer and deeper than a Controller Pak.
;
; THE PAK GOES INSIDE THE BAY: the prong is 35 mm of pak that slides up into
; the port, not a stub that meets the shell. 51 x 14 is the rectangle that fits
; that port -- see controller_pak.tscn for the measurement -- and all three paks
; share it because it is the same port.
;
; Same frame convention as the Controller Pak, with the mating face at y = +0.002
; and the origin 2 mm behind it so the port seats the FACE and not the centre:
;
;   prong     0.0020 ..  0.0370   (51 x 14, inside the controller once seated)
;   face                 0.0020
;   neck     -0.0080 ..  0.0020   (57 x 26, the lip that caps the port)
;   battery  -0.0380 .. -0.0080   (60 x 28, the bulge)
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.06, 0.04, 0.03)

[sub_resource type="BoxMesh" id="BoxMesh_neck"]
size = Vector3(0.057, 0.01, 0.026)

[sub_resource type="BoxMesh" id="BoxMesh_battery"]
size = Vector3(0.06, 0.03, 0.028)

[sub_resource type="StandardMaterial3D" id="Mat_shell"]
albedo_color = Color(0.72, 0.71, 0.68, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.1, 0.1, 0.11, 1)
roughness = 0.62

[sub_resource type="BoxMesh" id="BoxMesh_tongue"]
size = Vector3(0.051, 0.035, 0.014)

; The battery door, a shade darker so the bulge reads as a lid rather than as
; more shell.
[sub_resource type="BoxMesh" id="BoxMesh_door"]
size = Vector3(0.048, 0.022, 0.001)

[sub_resource type="StandardMaterial3D" id="Mat_door"]
albedo_color = Color(0.63, 0.62, 0.6, 1)
roughness = 0.6

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.07, 0.05, 0.04)

[node name="RumblePak" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
mass = 0.07
physics_material_override = SubResource("PhysMat_pak")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_pakscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.018, -0.003)
shape = SubResource("BoxShape3D_body")

[node name="Neck" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.003, -0.003)
mesh = SubResource("BoxMesh_neck")
surface_material_override/0 = SubResource("Mat_shell")

[node name="Battery" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.023, -0.003)
mesh = SubResource("BoxMesh_battery")
surface_material_override/0 = SubResource("Mat_shell")

[node name="Door" type="MeshInstance3D" parent="Battery"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.0142)
mesh = SubResource("BoxMesh_door")
surface_material_override/0 = SubResource("Mat_door")

; Points UP (+Y), into the bay. Named Tongue for continuity —
; Tools/input/n64_pak_probe.tscn finds it by this name and measures it against
; the bay opening.
[node name="Tongue" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0195, 0)
mesh = SubResource("BoxMesh_tongue")
surface_material_override/0 = SubResource("Mat_dark")

; IDENTITY. See the note in controller_pak.tscn — a snap zone composes the grab
; point, so this is what the y-table above is measured from.
[node name="GrabPoint" type="Marker3D" parent="."]
visible = false
script = ExtResource("3_grabpoint")

[node name="PickableHighlight" type="Node3D" parent="."]
