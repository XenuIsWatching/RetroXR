[sub_resource type="PhysicsMaterial" id="PhysMat_ctrl"]
friction = 0.8

; A primitive stand-in for the three-pronged pad, in the same spirit as
; retro_controller.tscn: no imported model, every part authored here.
;
; 135 mm across the wings, with three grips hanging off it. The one number that
; other files depend on is the CENTRE GRIP'S BOTTOM FACE at y = -0.060, because
; that is where the expansion port is and the three paks are measured from it.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.135, 0.082, 0.056)

