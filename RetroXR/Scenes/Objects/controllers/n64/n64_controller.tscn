[sub_resource type="PhysicsMaterial" id="PhysMat_ctrl"]
friction = 0.8

; 159.3 x 62.8 x 149.8 mm — the shell's own measured extent, printed by
; Tools/glb/glb_report.py, not a guess. See ATTRIBUTION.txt beside the .glb.
;
; The 62.8 mm depth includes the expansion bay block, which hangs below
; everything else on the shell.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.1593, 0.0628, 0.1498)

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.169, 0.067, 0.159)

[node name="N64Controller" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
mass = 0.2
physics_material_override = SubResource("PhysMat_ctrl")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_ctrlscript")
systemid = "nintendo_64"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0314, 0)
shape = SubResource("BoxShape3D_body")

[node name="Model" type="Node3D" parent="."]

; No rotation. The shell already arrives in RetroXR's frame — +Y out of the
; button face, +X to the player's right, +Z toward the player — which was
; confirmed by MEASURING the outward normals of Btn_L, Btn_R and Btn_Z (all
; three point -Z, so -Z is the rear edge the cable and shoulders live on) and
; then by rendering it, NOT by reasoning about axis signs. Tools/glb/
; prepare_n64_pad.py bakes the centimetre-to-metre scale into the file, so no
; import scale is needed either.
;
; The offset only re-centres the mesh and puts the button face at y = 0: the
; raw shell sits x-centred, y 0.0008..0.0636, z -0.0703..+0.0794.
[node name="Shell" parent="Model" instance=ExtResource("6_shell")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.06355, -0.00455)

; The expansion bay, measured off the shell's own underside. Its mouth is the
; LOWEST face on the whole controller (y = 0.0008 raw, -0.0628 here), spanning
; x +-25.5 mm and z -66..-38 mm, with the connector pins 37 mm up inside it.
;
; The zone stands 2 mm proud of that mouth, which is what puts a seated pak's
; mating face on the surface rather than 2 mm inside it — see the frame table in
; any of the three pak scenes.
;
; Centred on the opening's FULL-WIDTH band, not on the bay block. The opening is
; a rounded 55 x 24 mm hole that tapers at both ends -- 29 mm wide at z = -70,
; 55 mm from -62 to -48, 44 mm at -46 -- so the rectangle an insert can actually
; occupy is 55 x 14 centred at z = -55, and that is what the three paks are
; sized to. Centring on the block instead would push the insert into the taper.
;
; snap_require narrows it to plugs; n64_controller.gd inherits RetroController's
; narrowing to the "n64_pak" group, so a cable end offered here is refused.
[node name="ExpansionPort" parent="." instance=ExtResource("5_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0648, -0.0550)
grab_distance = 0.035
snap_require = "controller_plug"

; The cable leaves the middle of the rear edge, between the shoulders.
[node name="CableAttachPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.014, -0.0745)

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("2_pickhigh")

