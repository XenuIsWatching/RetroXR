; The shell, measured off the .glb: 61.0 x 36.6 x 96.0 mm. It rests ON its
; origin, so the box is lifted half its height to wrap it.
[sub_resource type="BoxShape3D" id="BoxShape3D_mouse"]
size = Vector3(0.061, 0.0366, 0.096)

; Deliberately larger than the shell — this is only what the laser has to hit to
; select the mouse, and a pointer target the size of the object is fiddly.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.1, 0.08, 0.14)

[sub_resource type="PhysicsMaterial" id="PhysMat_mouse"]
bounce = 0.0
friction = 0.8

[node name="SnesMouse" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_mouse")
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_snesmouse")
plug_mesh_path = "res://imported-assets/controllers/snes-mouse/snes_mouse_plug.res"
