[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0183, 0)
shape = SubResource("BoxShape3D_mouse")

; RetroMouse glues THIS node to the surface plane while the mouse is in use, so
; the model has to sit on the node's own origin — which is how the .glb was
; exported (y 0 .. 0.0366), leaving the transform at identity.
[node name="MouseVisual" type="Node3D" parent="."]

[node name="Model" parent="MouseVisual" instance=ExtResource("5_model")]

; Where the cord leaves the nose, measured from the wire mesh before it was
; dropped: dead centre, 7.3 mm off the desk. Parented to MouseVisual, the node
; glued to the surface, so the cord leaves the shell rather than the hand.
[node name="CableAttachPoint" type="Node3D" parent="MouseVisual"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0073, -0.048)

[node name="SurfaceRay" type="RayCast3D" parent="."]
target_position = Vector3(0, -0.1, 0)
