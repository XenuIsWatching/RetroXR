; Baked RCA plug (Tools/gen/gen_rca_plug.gd). No transform: the mesh is authored
; connector-on-+Z, unlike a CylinderMesh which is Y-up and needed rotating. No
; surface_material_override either — the materials are baked into the mesh, and
; surface 0 is deliberately the yellow plastic so system.gd's
; _decorate_channel_plug tints the BODY blue for a dual-screen host's BOTTOM
; channel rather than the metal. The mesh carries its own ribbed strain relief,
; so the separate StrainRelief node is gone.
[node name="PlugTip" type="MeshInstance3D" parent="CablePlug"]
mesh = ExtResource("5_rcaplug")

; Layer 21 (pointable) is the only layer the FunctionPointer's RayCast masks, so
; without this the beam passes straight through the plug — the plug body itself
; sits on layer 3 (pickable). Same StaticBody-child pattern as system.tscn;
; function_pickup._resolve_pickable maps the hit back to the parent pickable.
[node name="PointerArea" type="StaticBody3D" parent="CablePlug"]
collision_layer = 1048576
collision_mask = 0

