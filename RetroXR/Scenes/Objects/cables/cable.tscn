[node name="SnapGrabPoint" parent="CablePlug" instance=ExtResource("4_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; The audio pair beside the picture cord. Same connector, same body, tinted by
; CablePlug.plug_color — the colour code is on the CONNECTOR, which is what a
; player matches to a socket, and the wires stay black (see the rope below).
;
; Only the yellow one carries anything: on a captive lead the sound travels with
; the picture (see RetroSystem.on_tv_connected), so these two are seated and
; pulled alongside it rather than resolving a route of their own. That is the
; difference between this lead and the spawnable CompositeCable, where every cord
; is a plain wire and the routing falls out of the sockets its ends sit in.
;
; Spread by one cord pitch across the ribbon's own axis (X): 3 mm here, which is
; 2 x tube_radius, so the three tails leave the breakout at the spacing the trunk
; already lies at.

[node name="CablePlugL" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.003, 0, 0)
