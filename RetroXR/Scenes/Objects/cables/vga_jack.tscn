[gd_scene load_steps=2 format=3]

[ext_resource type="ArrayMesh" path="res://Scenes/Objects/cables/vga_jack.res" id="1_jackmesh"]

; Socket-on-+Z with the origin on the FLANGE face (see Tools/gen/gen_vga.gd), so this
; drops onto a port node whose local +Z points out of the cabinet and needs no
; transform of its own — the same contract rca_jack.tscn carries.
;
; No script, unlike RcaJack: that one exists to recolour surface 0 for the white and
; red audio jacks, and a VGA socket has no colour code to apply.
[node name="VgaJack" type="MeshInstance3D"]
mesh = ExtResource("1_jackmesh")
